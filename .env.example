# Copy to .env (or let the in-app setup wizard write it).
OPENAI_API_KEY=sk-...
HACKBOT_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# HACKBOT_DATA_DIR=~/.hackbot
# HACKBOT_MAX_RESEARCHERS=3          # parallel researcher agents per question (1-4)
# HACKBOT_ACP_URL=http://127.0.0.1:8000   # remote ACP server (uv run hackbot-acp)
# HACKBOT_MCP_CONFIG=mcp_servers.json     # extra MCP servers (standard mcpServers JSON)
# HACKBOT_STREAM=true
# HACKBOT_SHOW_ACTIVITY=true
